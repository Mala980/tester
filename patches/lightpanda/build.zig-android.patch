--- a/build.zig
+++ b/build.zig
@@ -229,6 +229,13 @@ fn addExe(b: *Build, config: ExeConfig, name: []const u8, check_name: []const u8
         }),
     });

+    // Android requires position-independent executables; Zig 0.16 defaults to
